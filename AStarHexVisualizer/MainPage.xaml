<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AStarHexVisualizer.MainPage"
             Title="A* Hex Visualizer"
             BackgroundColor="#1A1A2E">

       <Grid ColumnDefinitions="*, 280" RowDefinitions="*">
            <GraphicsView
              x:Name="HexCanvas"      
              Grid.Column="0"
              Grid.Row="0"    
              BackgroundColor="#1A1A2E"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
             />
             <Border
              Grid.Column="1"
              Grid.Row="0"
              BackgroundColor="#12122A"
              Stroke="#2D2D44"
              StrokeThickness="1"
              >
              <ScrollView VerticalScrollBarVisibility="Default">
                  <VerticalStackLayout Padding="16" Spacing="0">
                        <Label
                              Text="A* Hex Visualizer"
                              FontSize="16"
                              TextColor="#E8E8F0"  
                              Margin="0,0,0,4"
                              FontAttributes="Bold"    
                        />
                        <Label
                              Text="Step-by-step pathfinding"
                              FontSize="11"
                              TextColor="#A0A8C0"  
                              Margin="0,0,0,24"
                        />
                        <BoxView 
                              HeightRequest="1"
                              Margin="0,0,0,24"
                              BackgroundColor="#2D2D44"      
                        />
                        <Label
                              Text="SCENARIO"
                              FontSize="10"
                              TextColor="#A0A8C0"  
                              Margin="0,0,0,8"
                              CharacterSpacing="2"
                        />
                  </VerticalStackLayout>
              </ScrollView>
             </Border>
       </Grid>

</ContentPage>